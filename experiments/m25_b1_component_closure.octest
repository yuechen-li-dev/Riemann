[Artifact]
fn PlotCompetitorGap() -> Void {
    var xs: Float[] = []
    var ys: Float[] = []
    for k in 0 .. 91 {
        let r = 3.503 + 0.009 * Float(k) / 90.0
        let p = RefineB1(r)
        let q = NextMinimum(r, p.Contact)
        xs = Append(xs, r)
        ys = Append(ys, q.Objective)
    }
    let _p = PlotLine(xs, ys, "artifacts/m25/m25_competitor_gap.png")
}
