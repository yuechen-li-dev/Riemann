// M19 ApproximateVisualization of the exact M18 candidate.
// Firmament has no pi constant, so c and w are IEEE-754 decimal approximations.
Model M18Tangent {
  Units: mm;
  Panel spectral_surface {
    Surface: ParametricSurface {
      DomainU: [1.3, 1.85]; DomainV: [-0.05, 0.05];
      X: 20mm * u;
      Y: 20mm * v;
      Z: 20mm * (1 + 2 * (cos(u) - 1) / u^2 + 2 * (1 - 1.1487783910298668) * sin(u) / u + 2 * 0.17103742708003555 * cos(u));
    }
    Orientation: Front;
    Thickness: 0.2mm;
    Material: "ApproximateVisualization";
  }
  Panel zero_boundary {
    Surface: ParametricSurface {
      DomainU: [1.3, 1.85]; DomainV: [-0.05, 0.05];
      X: 20mm * u;
      Y: 20mm * v;
      Z: 0mm;
    }
    Orientation: Front;
    Thickness: 0.1mm;
    Material: "ReferenceOnly";
  }
}
