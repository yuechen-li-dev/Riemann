package A2Witnesses

[Fact]
fn SeparateChains() -> Void {
    var comparisons = 0
    var systems = 0
    var joint = 0
    for chain in 1 .. 3 {
        if 1 % chain == 0 { comparisons = comparisons + 1 }
        if chain % 2 == 0 { systems = systems + 1 }
        if 1 % chain == 0 and chain % 2 == 0 { joint = joint + 1 }
    }
    Assert.Equal(1, comparisons, "chain dividing column")
    Assert.Equal(1, systems, "chain divisible by two")
    Assert.Equal(0, joint, "shared chains")
}
